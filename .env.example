# Booking emails (Gmail). Copy this file to .env.local and fill in.
# SMTP_PASS must be a Gmail "App password", not your normal password:
# Google Account > Security > 2-Step Verification (turn on) > App passwords
SMTP_USER=leadcapp@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Where bookings are sent (defaults to SMTP_USER's address in lib/data.ts)
BOOKING_TO=leadcapp@gmail.com
# Optional, only for non-Gmail providers
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
